# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://newarix:newarix@localhost:15434/newarix

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# Redis for the Jikan cache and rate limiters (matches docker-compose.yml).
# Leave unset to use per-process memory (fine for a single dev server).
# Upstash and other hosted Redis work too: rediss://default:<token>@<host>:6379
REDIS_URL=redis://localhost:16379

# Optional: Postgres pool size. Defaults to 1 on Vercel, 10 elsewhere.
# DB_POOL_MAX=10

# Optional: point at a self-hosted Jikan instance
# JIKAN_BASE_URL=https://api.jikan.moe/v4

# Public origin used for email links and Google OAuth callbacks.
APP_URL=http://localhost:3000

# Email delivery via Resend; EMAIL_FROM must use a verified sender domain.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Newarix <accounts@your-domain.com>

# Google OAuth web application credentials. Register this callback URL:
# https://your-domain.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
